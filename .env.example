# Copy to .env — everything here is OPTIONAL and only seeds the very first start (before settings.json exists).
# After that, Settings in the UI are the source of truth (set IRIS_ENV_OVERRIDES=1 to make env win on every start).
# NOTE: docker compose does NOT support inline comments — keep comments on their own lines.

# auto | cuda | cpu
IRIS_COMPUTE_MODE=

# Megabytes of SOURCE LOG the case-less pool may hold. LEAVE BLANK (the default) for NO CAP:
# uploaded evidence has to be searchable, and a file silently absent from search is worse than a
# slow Iris, because nothing about a search says it was answered over part of the corpus.
# Not a RAM figure. Parsed Events measure ~3-4 bytes of RAM per source byte for a plain log and
# ~9-13 for one with many parsed columns; Iris measures the real ratio for YOUR pool rather than
# quoting a constant. Set a number only where you would rather lose a source than the machine.
IRIS_POOL_MAX_MB=

# MCP server (Iris as a tool provider for Cursor / Claude Code). Seeds the first start only —
# after that Settings -> MCP server is the source of truth. Writes are a SEPARATE switch, and a
# token is REQUIRED: enabling the server without one makes it refuse every request (503), because
# Iris has no other authentication and the reads are the sensitive asset in a forensics tool.
IRIS_MCP_ENABLED=
IRIS_MCP_ALLOW_WRITES=
IRIS_MCP_TOKEN=

# --- Security. Iris has no user model; these are the four knobs that decide who can reach it. ---
# Which host interface the published port binds to. Blank = 127.0.0.1, i.e. this machine only.
# Set 0.0.0.0 ONLY together with IRIS_AUTH_TOKEN — every endpoint, including the one that wipes the
# workspace and the one that deletes a source's file from disk, is otherwise open to the network.
IRIS_BIND_HOST=
# A shared secret for the whole API. Blank = no gate. Send it as "Authorization: Bearer <token>" or
# "X-Iris-Token: <token>", or open the UI once at http://<host>:<port>/?token=<token> and the browser
# keeps it in a cookie. /api/health stays open so healthchecks and start.sh still work.
IRIS_AUTH_TOKEN=
# Origins allowed to read a cross-origin response. Blank = localhost/127.0.0.1 on the app port plus
# the Vite dev server on 5173. NEVER "*": on an unauthenticated API that lets every page the analyst
# visits read the whole evidence pool. Comma-separated.
IRIS_CORS_ORIGINS=
# Extra DNS names Iris will answer to (a reverse proxy's hostname). Blank = localhost and IP
# addresses only, which is what stops a DNS-rebinding page from reaching this port.
IRIS_ALLOWED_HOSTS=

# openai | none
IRIS_AI_PROVIDER=
IRIS_AI_MODEL=
# e.g. http://host.docker.internal:11434/v1 for Ollama, https://10.0.0.109:3001/v1 for a local server
IRIS_AI_BASE_URL=
IRIS_AI_API_KEY=
