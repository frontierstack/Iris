# Security: never run a dependency's install/postinstall script. Iris's tree needs none —
# the only two packages that declare one are esbuild (its platform binary arrives as an
# optionalDependency, which npm still installs) and fsevents (macOS-only, optional).
# An install script runs arbitrary code from a transitive package at install time, which is
# the standard npm supply-chain foothold; the frontend build is verified to work without them.
ignore-scripts=true
